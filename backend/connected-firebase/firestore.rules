rules_version = '2';
// Two parts:
//  1. VenGuard Connected (future, Blaze plan): customers can READ only their own sites, devices,
//     events and commands.
//  2. Team dashboard (team-dashboard/): the company's orders, invoices, stock, promo codes and
//     marketing costs. Only Google sign-ins on the team list get in; only the company account
//     manages the team. Tests: rules-test/firestore.test.mjs.
//
// 1. VenGuard Connected. Customers can READ only their own sites, devices, events and commands.
// Every WRITE that matters (close commands, contacts, plans, device state) goes through Cloud Functions,
// which check membership and the Connected plan. Nobody can write a command directly.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'lang', 'fcmTokens'])
        && (!('name' in request.resource.data) || request.resource.data.name is string && request.resource.data.name.size() <= 60);
    }

    match /sites/{siteId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
      match /events/{eventId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/sites/$(siteId)).data.memberUids;
        allow write: if false;
      }
      match /alertLog/{x} { allow read, write: if false; }
    }

    match /devices/{deviceId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
      match /commands/{commandId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/devices/$(deviceId)).data.memberUids;
        allow write: if false;
      }
    }

    match /payments/{id} { allow read, write: if false; }

    // ---------------- 2. Team dashboard ----------------
    // The company account. It is always a founder, is the only one who adds or removes people,
    // and cannot be locked out. Keep in step with team-dashboard/config.json ("owner").
    function ownerEmail() { return 'oasisnextbd@gmail.com'; }
    function email() { return request.auth.token.email.lower(); }
    function google() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isOwner() { return google() && email() == ownerEmail(); }
    function member() { return get(/databases/$(database)/documents/team/$(email())).data; }
    // On the team list, switched on, and not past the optional end date (until_ms, set for guests).
    function onList() {
      return google() && exists(/databases/$(database)/documents/team/$(email())) && member().active == true
        && (!('until_ms' in member()) || request.time.toMillis() <= member().until_ms);
    }
    // Staff (founder, support, marketing). Guests are NOT staff: every "isTeam()" rule below shuts them out
    // of company data (orders, customers, invoices, stock, costs, ratings, settings…).
    function isMember() { return onList() && member().role != 'guest'; }
    // Guests (outside reviewers, testers): only their own team row, their assigned emulator, their own
    // tasks and their own online status.
    function isGuest() { return onList() && member().role == 'guest'; }
    function isTeam() { return isOwner() || isMember(); }
    function anyone() { return isTeam() || isGuest(); }
    function role() { return isOwner() ? 'founder' : member().role; }
    function hasRole(roles) { return isTeam() && role() in roles; }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function smallText(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }

    match /team/{who} {
      // Everyone may read their own row (the dashboard checks it at sign-in); staff read the whole list.
      allow read: if isTeam() || (google() && who == email());
      allow create, update: if isOwner() && who == who.lower()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active', 'until', 'until_ms', 'updated_at', 'updated_by'])
        && request.resource.data.email == who
        && request.resource.data.role in ['founder', 'support', 'marketing', 'guest']
        && request.resource.data.active is bool
        && (!('until_ms' in request.resource.data) || request.resource.data.until_ms is int)
        && smallText(request.resource.data, 'until', 10)
        && smallText(request.resource.data, 'name', 80);
      allow delete: if false;   // remove = active: false, so the history stays readable
    }

    function teamOrder() {
      return hasRole(['founder', 'support'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.status in ['new', 'payment_pending', 'contacted', 'paid', 'refunded', 'installed', 'not_interested'];
    }
    // The website's forms (signed out) may CREATE a new order with exactly the form's fields,
    // and never read, change or delete one. Keep the field list in step with venguard/assets/js/site.js.
    function text(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function websiteOrder(id) {
      let d = request.resource.data;
      return id.matches('^VG-[0-9]{6}-[A-Z0-9]{4}$') && d.order_id == id && d.source == 'website'
        && d.keys().hasOnly(['order_id', 'source', 'form_type', 'status', 'submitted_at', 'name', 'phone', 'email',
             'organisation', 'area', 'district', 'kitchen_type', 'business_type', 'units', 'cylinder_brand', 'heard_from',
             'dealer_code', 'promo_code', 'package', 'message', 'consent', 'lang', 'page_url', 'landing_page', 'referrer',
             'qr_tag', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content'])
        && d.form_type in ['preorder', 'enquiry', 'dealer', 'waitlist', 'contact']
        && d.status in ['new', 'payment_pending']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.phone is string && d.phone.matches('^01[3-9][0-9]{8}$')
        && d.submitted_at is string && d.submitted_at.size() <= 40
        && text(d, 'message', 2000) && text(d, 'email', 120) && text(d, 'organisation', 160) && text(d, 'area', 120)
        && text(d, 'district', 60) && text(d, 'units', 10) && text(d, 'promo_code', 24) && text(d, 'dealer_code', 24)
        && text(d, 'page_url', 300) && text(d, 'landing_page', 300) && text(d, 'referrer', 300)
        && text(d, 'kitchen_type', 40) && text(d, 'business_type', 40) && text(d, 'cylinder_brand', 40) && text(d, 'heard_from', 60)
        && text(d, 'package', 40) && text(d, 'consent', 10) && text(d, 'lang', 5) && text(d, 'qr_tag', 60)
        && text(d, 'utm_source', 100) && text(d, 'utm_medium', 100) && text(d, 'utm_campaign', 100) && text(d, 'utm_content', 100);
    }
    match /orders/{id} {
      allow read: if isTeam();
      allow create: if teamOrder() || websiteOrder(id);
      allow update: if teamOrder();
      allow delete: if hasRole(['founder']);
    }

    // Invoices are never deleted. Support can issue and revise; only founders can void one.
    match /invoices/{id} {
      allow read: if isTeam();
      allow create: if hasRole(['founder', 'support']) && request.resource.data.status == 'issued';
      allow update: if hasRole(['founder'])
        || (hasRole(['support']) && resource.data.status == 'issued' && request.resource.data.status == 'issued');
      allow delete: if false;
    }
    match /counters/{id} {
      allow read: if isTeam();
      allow write: if hasRole(['founder', 'support']) && request.resource.data.next is int;
    }

    match /inventory/{sku} {
      allow read: if isTeam();
      allow create, delete: if hasRole(['founder']);
      allow update: if hasRole(['founder'])
        || (hasRole(['support']) && changes().hasOnly(['stock', 'updated_at']));
    }
    match /stockMoves/{id} {
      allow read: if isTeam();
      allow create: if hasRole(['founder', 'support']) && request.resource.data.by == email()
        && request.resource.data.qty is int;
      allow update, delete: if false;
    }
    match /products/{id} {
      allow read: if isTeam();
      allow write: if hasRole(['founder']);
    }

    // The website may look up one active promo code at a time (no listing).
    match /promos/{code} {
      allow get: if (resource != null && resource.data.active == true) || isTeam();
      allow list: if isTeam();
      allow create, delete: if hasRole(['founder', 'marketing']) && code == code.upper();
      allow update: if hasRole(['founder', 'marketing'])
        || (hasRole(['support']) && changes().hasOnly(['used']));
    }

    match /marketing/{id} {
      allow read: if isTeam();
      allow write: if hasRole(['founder', 'marketing']);
    }
    match /dealers/{code} {
      allow read: if isTeam();
      allow write: if hasRole(['founder']);
    }

    // A signature image never changes once saved, so old invoices keep the signature they had.
    match /signatories/{id} {
      allow read: if isTeam();
      allow create: if hasRole(['founder'])
        && request.resource.data.signature is string && request.resource.data.signature.size() < 300000
        && request.resource.data.signature.matches('data:image/(png|jpeg);base64,.*');
      allow update: if hasRole(['founder']) && changes().hasOnly(['name', 'title', 'active']);
      allow delete: if false;
    }

    // settings/website (pre-orders open, price, notice) is public for the website, and settings/app
    // (notice and minimum version for the VenGuard app) for the app; the rest is team only.
    match /settings/{id} {
      allow get: if id in ['website', 'app'] || isTeam();
      allow list: if isTeam();
      allow write: if hasRole(['founder']);
    }

    // Star ratings from the website footer (team dashboard → Ratings). Anonymous: up to three 1–5 stars
    // (the device, the website, the service), the page and the language; no name, phone or tracking ID.
    // One document per browser (a random ID kept in the visitor's browser), so changing a star updates it
    // and the dashboard counts each visitor once. Visitors can write but never read; founders delete spam.
    // Keep the fields in step with setupRatings() in venguard/assets/js/site.js.
    function stars(d, k) { return !(k in d) || (d[k] is int && d[k] >= 1 && d[k] <= 5); }
    function websiteRating(id) {
      let d = request.resource.data;
      return id.matches('^R-[A-Za-z0-9]{20}$') && d.source == 'website'
        && d.keys().hasOnly(['source', 'product', 'website', 'service', 'created_at', 'updated_at', 'lang', 'page'])
        && d.keys().hasAny(['product', 'website', 'service'])
        && stars(d, 'product') && stars(d, 'website') && stars(d, 'service')
        && d.created_at is string && d.created_at.size() <= 40
        && d.updated_at is string && d.updated_at.size() <= 40
        && d.lang in ['bn', 'en'] && smallText(d, 'page', 120);
    }
    match /ratings/{id} {
      allow read: if isTeam();
      allow create: if websiteRating(id);
      allow update: if websiteRating(id) && request.resource.data.created_at == resource.data.created_at;
      allow delete: if hasRole(['founder']);
    }

    // Device emulators for the founders' tests (team dashboard → Emulators). Each record holds the sign-in
    // of one test device, so only the company account and the founder it is assigned to can read it;
    // only the company account creates, assigns or removes them. IDs VG-EMU01 … VG-EMU99 only.
    match /emulators/{id} {
      allow read: if isOwner() || ((hasRole(['founder']) || isGuest()) && resource.data.assigned_to == email());
      allow create, update: if isOwner() && id.matches('VG-EMU[0-9]{2}')
        && request.resource.data.device_id == id
        && request.resource.data.kit in ['complete', 'detector_relay']
        && request.resource.data.assigned_to is string;
      allow delete: if isOwner();
    }

    // Paid services and their renewal dates; founders keep the list, everyone on the team can see it.
    match /subscriptions/{id} {
      allow read: if isTeam();
      allow write: if hasRole(['founder']);
    }

    match /activity/{id} {
      allow read: if isTeam();
      allow create: if anyone() && request.resource.data.user == email();
      allow update, delete: if false;
    }

    // Who is at the dashboard: each person writes only their own "last seen" (about once a minute while
    // the dashboard is open). Only the company account reads them; everyone is told on screen.
    match /presence/{who} {
      allow read: if isOwner();
      allow write: if anyone() && who == email()
        && request.resource.data.keys().hasOnly(['email', 'last_seen', 'online'])
        && request.resource.data.email == who
        && request.resource.data.online is bool
        && request.resource.data.last_seen is string && request.resource.data.last_seen.size() <= 40;
    }

    // Tasks: the company account assigns, edits, approves or sends back; the person it is assigned to
    // sees only their own and may only submit it as done (with a note). Keep in step with
    // team-dashboard/js/store.js (saveTask, submitTask, reviewTask).
    function validTask() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'details', 'assignee', 'assignee_name', 'kind', 'due', 'status', 'created_at',
            'created_by', 'submitted_at', 'submit_note', 'reviewed_at', 'review_note', 'returned_count', 'files', 'link'])
        && (!('files' in d) || (d.files is list && d.files.size() <= 5)) && smallText(d, 'link', 500)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.assignee is string && d.assignee.size() <= 120
        && d.kind in ['daily', 'weekly', 'monthly', 'milestone']
        && d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.status in ['open', 'submitted', 'approved', 'returned']
        && smallText(d, 'details', 2000) && smallText(d, 'submit_note', 1000) && smallText(d, 'review_note', 1000)
        && smallText(d, 'assignee_name', 80);
    }
    match /tasks/{id} {
      allow read: if isOwner() || (anyone() && resource.data.assignee == email());
      allow create: if isOwner() && validTask();
      allow delete: if isOwner();
      allow update: if (isOwner() && validTask())
        || (anyone() && resource.data.assignee == email()
          && resource.data.status in ['open', 'returned'] && request.resource.data.status == 'submitted'
          && changes().hasOnly(['status', 'submit_note', 'submitted_at', 'files', 'link'])
          && request.resource.data.submitted_at is string && request.resource.data.submitted_at.size() <= 40
          && (!('files' in request.resource.data) || (request.resource.data.files is list && request.resource.data.files.size() <= 5))
          && smallText(request.resource.data, 'link', 500)
          && smallText(request.resource.data, 'submit_note', 1000));
    }

    // Files attached to a submitted task (proof of work). Kept in this free database, one file per
    // document (up to about 700 KB, as a data: URL): the person a task is assigned to adds them while it is
    // open or sent back; they and the company account can read them; only the company account deletes.
    match /taskFiles/{id} {
      function fileTask() { return get(/databases/$(database)/documents/tasks/$(request.resource.data.task_id)).data; }
      allow read: if isOwner() || (anyone() && resource.data.assignee == email());
      allow create: if anyone()
        && request.resource.data.keys().hasOnly(['task_id', 'name', 'type', 'size', 'data', 'assignee', 'uploaded_by', 'uploaded_at'])
        && request.resource.data.task_id is string
        && request.resource.data.assignee == email() && request.resource.data.uploaded_by == email()
        && fileTask().assignee == email() && fileTask().status in ['open', 'returned']
        && request.resource.data.data is string && request.resource.data.data.size() <= 1000000
        && request.resource.data.name is string && request.resource.data.name.size() <= 160
        && request.resource.data.type is string && request.resource.data.type.size() <= 120
        && request.resource.data.size is int
        && request.resource.data.uploaded_at is string && request.resource.data.uploaded_at.size() <= 40;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
